print("builtins")
print(abs(-3), max(1, 5), min([2, 1]), sum([1, 2, 3]))
print(pow(2, 3), sqrt(9), floor(3.7), ceil(3.1))
print(round(3.14159, 2))
print(list("ab"), tuple([1, 2]), dict([["a", 1]]))
print(slice([1, 2, 3, 4], 1, 3))
r <- random(10)
print(r >= 0 and r < 10)
print("{} {}".format(1, 2))
print("abc".find("b"), "abc".replace("b", "X"))
print(" Hi ".strip().upper())
print("a,b,c".split(","))
print("-".join(["x", "y"]))
print(id("x") > 0, hash("x") == hash("x"))
l <- [1]
l.append(2)
print(l)
d <- {"a": 1, "b": 2}
print(d.has("a"), d.has("z"), d.get("z", 9))
print(d.keys(), d.values())
a <- [1, 2]
b <- clone(a)
b.append(3)
print(a, b)
write("no", "newline")
print("")
print(double(1), type(double(1)), i64(5), type(i64(5)))
